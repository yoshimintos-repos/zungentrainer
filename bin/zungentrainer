#!/usr/bin/env python3
"""ZungenTrainer Launcher."""

import sys
import os

# Im Flatpak liegt alles unter /app
if os.path.exists("/app/share/zungentrainer"):
    app_dir = "/app/share/zungentrainer"
else:
    # Lokale Entwicklung
    app_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src")

if app_dir not in sys.path:
    sys.path.insert(0, app_dir)

# Sicherstellen, dass data-Verzeichnis gefunden wird
if os.path.exists("/app/share/zungentrainer"):
    data_dir = "/app/share/zungentrainer/data"
else:
    data_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "data")

os.environ.setdefault("ZUNGENTRAINER_DATA_DIR", data_dir)

from main import main
sys.exit(main())
